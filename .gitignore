.DS_Store
target/
# Linked git worktrees (each large audit cycle gets one). They are full
# nested checkouts — a stray `git add -A` would commit an entire duplicate
# repo + its `.git` pointer (codex v0.32.1 R1 P2).
.worktrees/
.claude/*.local.md
.claude/*.log
bench/
reviews/
eval-results/
bench/results*.jsonl
bench/results*.jsonl.*
__pycache__/
.superpowers/
docs/superpowers/
gui/dist/
gui/node_modules/

# Stray SQLite test artifacts (e.g. tests writing to relative path "auto")
auto
auto-shm
auto-wal
auto-journal

# AI-agent personal working notes — kept out of public repo on purpose
# (CLAUDE.md / SKILL.md are project-specific instructions for Claude Code
# and other AI agents; they live in vault root or operator's private notes
# rather than the public source tree). AGENTS.md is the public-facing
# agent guide and IS tracked.
CLAUDE.md
SKILL.md

# THIRD_PARTY_NOTICES YAML — regenerable build artifact (the .md is the
# canonical human-readable + tracked version). Regenerate via
# scripts/generate-third-party-notices.sh
THIRD_PARTY_NOTICES.yaml

# TLS certificates and private keys — must NEVER be committed.
# Defense-in-depth against `tailscale cert <name>` (writes <name>.crt
# and <name>.key into cwd), Let's Encrypt artifacts, and any other
# tooling that drops keys into the working tree.
*.crt
*.key
*.pem
*.p12
*.pfx

# macOS Finder " 2"-style duplicates produced by cmd+D / drag-copy.
# Repeatedly bitten v0.25.2 / v0.26.2 / v0.30.2 / v0.31.0 / v0.32.0 release
# cycles — these patterns block them from creeping into commits.
* 2.*
* 3.*
* 4.*
* copy.*
* copy 2.*
